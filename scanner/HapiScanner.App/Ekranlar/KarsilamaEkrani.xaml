<UserControl x:Class="HapiScanner.App.Ekranlar.KarsilamaEkrani"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arayuz="clr-namespace:HapiScanner.Core.Arayuz;assembly=HapiScanner.Core"
             xmlns:m3b="clr-namespace:HapiScanner.App.Model3B">

    <Grid Margin="48,40,40,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="420"
                    HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Etiket}" Text="HAPİCRAFT DOĞRULAMA" />
            <TextBlock Style="{StaticResource BaslikBuyuk}" Margin="0,10,0,0"
                       Text="{x:Static arayuz:Metinler.KarsilamaBaslik}" />
            <TextBlock Style="{StaticResource Govde}" Margin="0,16,0,0"
                       Text="{x:Static arayuz:Metinler.KarsilamaOzet}" />

            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Image Source="{StaticResource IkonKilit}" Width="20" Height="20"
                       Style="{StaticResource PixelGorsel}" VerticalAlignment="Center" />
                <TextBlock Margin="12,0,0,0" Style="{StaticResource Kucuk}" VerticalAlignment="Center"
                           Text="Önce ne topladığımızı, ne toplamadığımızı göstereceğiz." />
            </StackPanel>

            <TextBlock Style="{StaticResource Kucuk}" Margin="2,14,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Kotu}" Text="{Binding KurulumUyarisi}"
                       Visibility="{Binding KurulumUyarisi, Converter={StaticResource DoluysaGorunur}}" />

            <Button Style="{StaticResource ButonBirincil}" HorizontalAlignment="Left"
                    Margin="0,30,0,0" Click="Basla"
                    Content="{x:Static arayuz:Metinler.KarsilamaButon}" />
        </StackPanel>

        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,10,0">
            <Border Width="300" Height="300" CornerRadius="150" Opacity="0.10"
                    Background="{StaticResource MarkaYesil}" />
            <m3b:Karakter3B AktifEkran="Karsilama" Width="300" Height="340" />
        </Grid>
    </Grid>
</UserControl>
