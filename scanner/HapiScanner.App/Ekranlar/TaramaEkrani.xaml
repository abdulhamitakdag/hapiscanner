<UserControl x:Class="HapiScanner.App.Ekranlar.TaramaEkrani"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arayuz="clr-namespace:HapiScanner.Core.Arayuz;assembly=HapiScanner.Core"
             xmlns:m3b="clr-namespace:HapiScanner.App.Model3B">

    <Grid Margin="40,32,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Baslik + karakter -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource Etiket}" Text="ADIM 3 / 4" />
            <TextBlock Style="{StaticResource Baslik}" FontSize="22" Margin="0,8,0,0"
                       Text="{x:Static arayuz:Metinler.TaramaBaslik}" />
            <TextBlock Style="{StaticResource Govde}" Margin="0,8,0,0" MaxWidth="470"
                       HorizontalAlignment="Left"
                       Text="{x:Static arayuz:Metinler.TaramaAciklama}" />
        </StackPanel>

        <!-- Karakter animasyonu aktif asamayla birlikte degisir: kullanici
             taramanin nerede oldugunu yuzde cubugundan baska buradan da gorur. -->
        <m3b:Karakter3B Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        AktifEkran="Tarama"
                        Asama="{Binding AktifAsama}"
                        Ilerleme="{Binding Ilerleme}"
                        Width="200" Height="220"
                        VerticalAlignment="Top" Margin="20,0,6,0" />

        <!-- Ilerleme -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,22">
            <Grid Margin="0,0,0,8">
                <TextBlock Style="{StaticResource Baslik}" FontSize="15"
                           Text="{Binding AktifAsamaBasligi}" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Baslik}" FontSize="15"
                           Foreground="{StaticResource MarkaYesil}" HorizontalAlignment="Right">
                    <Run Text="{Binding Ilerleme, Mode=OneWay}" /><Run Text="%" />
                </TextBlock>
            </Grid>

            <Border Height="8" CornerRadius="4" Background="{StaticResource ZeminRaf}"
                    BorderBrush="{StaticResource Cizgi}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Ilerleme, Converter={StaticResource YuzdeSutunu}}" />
                        <ColumnDefinition Width="{Binding Ilerleme, Converter={StaticResource YuzdeSutunu},
                                                  ConverterParameter=ters}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="3" Background="{StaticResource MarkaYesil}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Asamalar + gunluk -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Kart}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Etiket}" Text="AŞAMALAR" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Asamalar}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Border Width="9" Height="9" CornerRadius="2" Margin="0,6,0,0"
                                            VerticalAlignment="Top"
                                            Background="{Binding Durum, Converter={StaticResource AsamaRengi}}" />
                                    <StackPanel Margin="11,0,0,0">
                                        <TextBlock Style="{StaticResource Kucuk}" FontSize="13"
                                                   Foreground="{Binding Durum, Converter={StaticResource AsamaRengi}}"
                                                   Text="{Binding Baslik}" />
                                        <TextBlock Style="{StaticResource Kucuk}" MaxWidth="240"
                                                   HorizontalAlignment="Left"
                                                   Visibility="{Binding Calisiyor, Converter={StaticResource BoolGorunurluk}}"
                                                   Text="{Binding Aciklama}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Kart}" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Etiket}"
                               Text="TARAMA GÜNLÜĞÜ" Margin="0,0,0,10" />
                    <!-- Gunluge dusen satirlar GunlukSuzgeci'nden gecer: ekranda
                         tam dosya yolu veya token gorunmez. -->
                    <ItemsControl x:Name="GunlukListesi" ItemsSource="{Binding Gunluk}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="Kaydirici" Style="{StaticResource SessizKaydirici}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource YaziTek}" FontSize="11.5"
                                           Foreground="{StaticResource MetinSolgun}" Margin="0,0,0,4"
                                           TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Iptal -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,20,0,0">
            <Button Style="{StaticResource ButonIkincil}" Click="Iptal"
                    IsEnabled="{Binding IptalEdilebilir}"
                    Content="{x:Static arayuz:Metinler.IptalButon}" />
            <TextBlock Style="{StaticResource Kucuk}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Text="İptal edersen yetkiliye &quot;tarama tamamlanmadı&quot; bilgisi gider." />
        </StackPanel>
    </Grid>
</UserControl>
