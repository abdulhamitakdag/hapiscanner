<UserControl x:Class="HapiScanner.App.Ekranlar.GizlilikEkrani"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arayuz="clr-namespace:HapiScanner.Core.Arayuz;assembly=HapiScanner.Core"
             xmlns:m3b="clr-namespace:HapiScanner.App.Model3B">

    <UserControl.Resources>
        <!-- Madde satiri: kucuk kare + metin -->
        <DataTemplate x:Key="MaddeYesil">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                <Border Width="6" Height="6" CornerRadius="1" Margin="0,7,0,0"
                        VerticalAlignment="Top" Background="{StaticResource MarkaYesil}" />
                <TextBlock Style="{StaticResource Kucuk}" Margin="10,0,0,0"
                           Foreground="{StaticResource MetinIkincil}" Text="{Binding}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="MaddeKirmizi">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                <Border Width="6" Height="6" CornerRadius="1" Margin="0,7,0,0"
                        VerticalAlignment="Top" Background="{StaticResource Kotu}" />
                <TextBlock Style="{StaticResource Kucuk}" Margin="10,0,0,0"
                           Foreground="{StaticResource MetinIkincil}" Text="{Binding}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="40,32,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Baslik -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Baslik}" FontSize="22"
                           Text="{x:Static arayuz:Metinler.GizlilikBaslik}" />
                <TextBlock Style="{StaticResource Govde}" Margin="0,8,0,0" MaxWidth="560"
                           HorizontalAlignment="Left"
                           Text="{x:Static arayuz:Metinler.GizlilikAltBaslik}" />
            </StackPanel>

            <m3b:Karakter3B Grid.Column="1" AktifEkran="Gizlilik"
                            Width="120" Height="120" Margin="16,0,0,0"
                            VerticalAlignment="Top" />
        </Grid>

        <!-- Kartlar -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource SessizKaydirici}" Margin="0,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Yapmaz -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Kart}" Margin="0,0,8,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="{StaticResource IkonKilit}" Width="20" Height="20"
                                   Style="{StaticResource PixelGorsel}" />
                            <TextBlock Style="{StaticResource Baslik}" FontSize="15" Margin="10,0,0,0"
                                       Text="Bu araç neleri YAPMAZ" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Static arayuz:Metinler.Yapmaz}"
                                      ItemTemplate="{StaticResource MaddeKirmizi}" />
                    </StackPanel>
                </Border>

                <!-- Bakar -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Kart}" Margin="8,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="{StaticResource IkonBuyutec}" Width="20" Height="20"
                                   Style="{StaticResource PixelGorsel}" />
                            <TextBlock Style="{StaticResource Baslik}" FontSize="15" Margin="10,0,0,0"
                                       Text="Neye bakar" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Static arayuz:Metinler.Bakar}"
                                      ItemTemplate="{StaticResource MaddeYesil}" />
                    </StackPanel>
                </Border>

                <!-- Gonderilir -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Kart}" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="{StaticResource IkonSunucu}" Width="20" Height="20"
                                   Style="{StaticResource PixelGorsel}" />
                            <TextBlock Style="{StaticResource Baslik}" FontSize="15" Margin="10,0,0,0"
                                       Text="Sunucuya ne gider" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Static arayuz:Metinler.Gonderilir}"
                                      ItemTemplate="{StaticResource MaddeYesil}" />
                    </StackPanel>
                </Border>

                <!-- Gonderilmez -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Kart}" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Source="{StaticResource IkonDosya}" Width="20" Height="20"
                                   Style="{StaticResource PixelGorsel}" />
                            <TextBlock Style="{StaticResource Baslik}" FontSize="15" Margin="10,0,0,0"
                                       Text="Ne gitmez" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Static arayuz:Metinler.Gonderilmez}"
                                      ItemTemplate="{StaticResource MaddeKirmizi}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Onay -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Border Height="1" Background="{StaticResource Cizgi}" Margin="0,0,0,18" />
            <CheckBox Style="{StaticResource OnayKutusu}"
                      IsChecked="{Binding OnayVerildi, Mode=TwoWay}"
                      Content="{x:Static arayuz:Metinler.OnayMetni}" />
            <TextBlock Style="{StaticResource Kucuk}" Margin="34,8,0,0"
                       Foreground="{StaticResource Uyari}"
                       Text="{Binding HataMesaji}"
                       Visibility="{Binding HataMesaji, Converter={StaticResource DoluysaGorunur}}" />
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource ButonBirincil}" Click="Devam"
                        IsEnabled="{Binding DevamEdilebilir}" Content="Devam et" />
                <Button Style="{StaticResource ButonSessiz}" Margin="8,0,0,0"
                        Click="Geri" Content="Geri" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
