<UserControl x:Class="HapiScanner.App.Ekranlar.SonucEkrani"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arayuz="clr-namespace:HapiScanner.Core.Arayuz;assembly=HapiScanner.Core"
             xmlns:m3b="clr-namespace:HapiScanner.App.Model3B">

    <Grid Margin="40,32,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sonuc basligi -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14"
                    Background="{StaticResource PanelAcik}" VerticalAlignment="Top">
                <Image Source="{Binding SonucTonu, Converter={StaticResource TonIkonu}}"
                       Width="34" Height="34" Style="{StaticResource PixelGorsel}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="18,2,0,0">
                <TextBlock Style="{StaticResource Etiket}" Text="ADIM 4 / 4 · TARAMA TAMAMLANDI" />
                <TextBlock Style="{StaticResource BaslikBuyuk}" FontSize="25" Margin="0,8,0,0"
                           Foreground="{Binding SonucTonu, Converter={StaticResource TonRengi}}"
                           Text="{Binding SonucBasligi}" />
                <TextBlock Style="{StaticResource Kucuk}" Margin="0,8,0,0" MaxWidth="470"
                           HorizontalAlignment="Left"
                           Text="{x:Static arayuz:Metinler.SonucNotu}" />
            </StackPanel>

            <m3b:Karakter3B Grid.Column="2" AktifEkran="Sonuc"
                            SonucTonu="{Binding SonucTonu}"
                            Width="170" Height="180"
                            VerticalAlignment="Top" Margin="12,0,0,0" />
        </Grid>

        <!-- Kapsam -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,16">
            <Border Style="{StaticResource Kart}" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Etiket}" Text="DOSYA SİSTEMİ KAPSAMI" />
                    <TextBlock Style="{StaticResource Baslik}" FontSize="14" Margin="0,4,0,0"
                               Text="{Binding Sonuc.ForensicCoverage}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Kart}" Padding="14,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Etiket}" Text="RUNTIME KAPSAMI" />
                    <TextBlock Style="{StaticResource Baslik}" FontSize="14" Margin="0,4,0,0"
                               Text="{Binding Sonuc.RuntimeCoverage}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Kanitlar -->
        <Border Grid.Row="2" Style="{StaticResource Kart}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Etiket}"
                           Text="YETKİLİYE GİDEN KANIT ÖZETİ" Margin="0,0,0,12" />

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Kucuk}"
                           Text="Kanıt üretilmedi. Rapor yalnızca kapsam ve sonuç bilgisini içerir."
                           Visibility="{Binding Sonuc.Kanitlar.Count,
                                        Converter={StaticResource SifirsaGorunur}}" />

                <ScrollViewer Style="{StaticResource SessizKaydirici}">
                    <ItemsControl ItemsSource="{Binding Sonuc.Kanitlar}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelAcik}" CornerRadius="8"
                                        Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Baslik}" FontSize="14"
                                                       Text="{Binding RuleId}" />
                                            <TextBlock Style="{StaticResource Kucuk}" Margin="0,3,0,0">
                                                <Run Text="{Binding ArtifactCategory, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding EvidenceType, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Style="{StaticResource Etiket}"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Severity}" />
                                            <TextBlock Style="{StaticResource Kucuk}" Margin="0,3,0,0"
                                                       HorizontalAlignment="Right"
                                                       Text="{Binding Confidence}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource ButonBirincil}" Click="Kapat"
                    Content="{x:Static arayuz:Metinler.KapatButon}" />
            <TextBlock Style="{StaticResource Kucuk}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Text="Rapor yetkiliye iletildi. Bu pencereyi kapatabilirsin." />
        </StackPanel>
    </Grid>
</UserControl>
