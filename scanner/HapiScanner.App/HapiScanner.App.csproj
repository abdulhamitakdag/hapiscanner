<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HapiScanner.App</RootNamespace>
    <AssemblyName>HapiScanner</AssemblyName>
    <Version>0.1.4</Version>
    <Product>HapiScanner</Product>
    <Company>HapiCraft</Company>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationIcon>Varliklar\hapiscanner.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HapiScanner.Core\HapiScanner.Core.csproj" />
    <ProjectReference Include="..\HapiScanner.Windows\HapiScanner.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\hapicraft-kurallar.json" Link="hapicraft-kurallar.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules\hapicraft-kurallar.json.sig" Link="hapicraft-kurallar.json.sig"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Varliklar\*.png" />
    <Resource Include="Varliklar\hapiscanner.ico" />
    <Resource Include="Varliklar\kaynak\*.png" />
  </ItemGroup>

</Project>
