<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Renkler.xaml" />
        <ResourceDictionary Source="Donusturucular.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================ Tipografi ============================ -->

    <FontFamily x:Key="Yazi">Segoe UI</FontFamily>
    <FontFamily x:Key="YaziTek">Consolas</FontFamily>

    <Style x:Key="BaslikBuyuk" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Metin}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Baslik" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Metin}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Govde" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource MetinIkincil}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="Kucuk" TargetType="TextBlock" BasedOn="{StaticResource Govde}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MetinSolgun}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="Etiket" TargetType="TextBlock" BasedOn="{StaticResource Kucuk}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MetinSolgun}" />
    </Style>

    <!-- ============================= Yuzeyler ============================ -->

    <Style x:Key="Kart" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ============================= Butonlar ============================ -->

    <Style x:Key="ButonTemel" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="govde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="govde" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="govde" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="govde" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButonBirincil" TargetType="Button" BasedOn="{StaticResource ButonTemel}">
        <Setter Property="Background" Value="{StaticResource MarkaYesil}" />
        <Setter Property="Foreground" Value="#FF0B1510" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ButonIkincil" TargetType="Button" BasedOn="{StaticResource ButonTemel}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Metin}" />
        <Setter Property="BorderBrush" Value="{StaticResource Cizgi}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ButonSessiz" TargetType="Button" BasedOn="{StaticResource ButonTemel}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MetinSolgun}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Pencere basligindaki kucuk kare butonlar -->
    <Style x:Key="ButonBaslikCubugu" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource MetinSolgun}" />
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="govde" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="govde" Property="Background" Value="{StaticResource PanelAcik}" />
                            <Setter Property="Foreground" Value="{StaticResource Metin}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Onay kutusu ========================= -->

    <Style x:Key="OnayKutusu" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Yazi}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Metin}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="kutu" Width="22" Height="22" CornerRadius="6"
                                Background="{StaticResource PanelAcik}"
                                BorderBrush="{StaticResource Cizgi}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="tik" Width="12" Height="12" Stretch="Uniform"
                                  Data="M 0,5 L 4,9 L 11,1"
                                  Stroke="#FF0B1510" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="kutu" Property="Background" Value="{StaticResource MarkaYesil}" />
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{StaticResource MarkaYesil}" />
                            <Setter TargetName="tik" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="kutu" Property="BorderBrush" Value="{StaticResource MarkaYesil}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Metin kutusu ======================== -->

    <Style x:Key="KodKutusu" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource YaziTek}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Metin}" />
        <Setter Property="CaretBrush" Value="{StaticResource MarkaYesil}" />
        <Setter Property="SelectionBrush" Value="{StaticResource MarkaYesil}" />
        <Setter Property="MaxLength" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="cerceve" Background="{StaticResource ZeminRaf}"
                            BorderBrush="{StaticResource Cizgi}" BorderThickness="1"
                            CornerRadius="10" Padding="18,14">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="cerceve" Property="BorderBrush" Value="{StaticResource MarkaYesil}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== Sol raydaki adim satiri ==================== -->

    <Style x:Key="Adim" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="11" Height="11" CornerRadius="2" VerticalAlignment="Center">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource AdimRengi}">
                                    <Binding Path="DataContext.AktifEkran"
                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="13,0,0,0" VerticalAlignment="Center"
                                          TextBlock.FontFamily="{StaticResource Yazi}"
                                          TextBlock.FontSize="14">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource AdimRengi}">
                                                <Binding Path="DataContext.AktifEkran"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                                <Binding Path="Tag"
                                                         RelativeSource="{RelativeSource AncestorType=ContentControl}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Kaydirma ============================ -->

    <!-- Ortuk stil: tum kaydirma cubuklari ince ve sessiz -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource Cizgi}" CornerRadius="3" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                          Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                          Focusable="False" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SessizKaydirici" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

</ResourceDictionary>
